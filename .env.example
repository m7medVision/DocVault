# DocVault — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit real .env files to version control.

# ── Application ─────────────────────────────────────────────
PORT=8080
ENVIRONMENT=development

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://docvault:docvault_dev@localhost:5432/docvault

# ── MinIO (Object Storage) ──────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=docvault-documents
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
MINIO_SECURE=false

# ── MinIO Backup Configuration ───────────────────────────────
BACKUP_MODE=local
BACKUP_ROOT=./backups
BACKUP_TARGET=

# ── RabbitMQ ────────────────────────────────────────────────
RABBITMQ_URL=amqp://docvault:changeme@localhost:5672//docvault
RABBITMQ_QUEUE_OCR=docvault.ocr.jobs
RABBITMQ_QUEUE_PROCESSING=docvault.processing.jobs
RABBITMQ_QUEUE_REMINDER=docvault.reminder.jobs
DLQ_QUEUE=docvault.reminder.dlq

# ── Redis (Caching & Sessions) ──────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10
REDIS_MAX_RETRIES=3
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# ── JWT Authentication ──────────────────────────────────────
JWT_SECRET=dev-jwt-secret-change-me
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=720h
JWT_ISSUER=docvault.app
JWT_AUDIENCE=docvault-api

# ── ZITADEL (Authentication) ────────────────────────────────
ZITADEL_DOMAIN=
ZITADEL_API_KEY=

# ── Mistral OCR ─────────────────────────────────────────────
MISTRAL_API_KEY=
MISTRAL_ENDPOINT=https://api.mistral.ai/v1/ocr

# ── OpenRouter Embeddings ──────────────────────────────────
OPENROUTER_API_KEY=
EMBEDDING_MODEL=mistralai/mistral-embed-2312

# ── Chunking ────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MIN_CONFIDENCE_THRESHOLD=0.7

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Web (Next.js) ───────────────────────────────────────────
API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ── Mobile (Expo) ──────────────────────────────────────────
# Android emulator:   http://10.0.2.2:8080/api/v1
# iOS simulator:      http://127.0.0.1:8080/api/v1
# Physical device:    http://<LAN-IP>:8080/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api/v1

# ── Presigned URLs ──────────────────────────────────────────
PRESIGNED_URL_TTL_SECONDS=900

# ── Observability ───────────────────────────────────────────
OTEL_EXPORTER_ENDPOINT=

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=debug

# ── Sentry (per service) ────────────────────────────────────
SENTRY_DSN_BACKEND=
SENTRY_DSN_WORKER=
SENTRY_DSN_PROCESSING=
SENTRY_DSN_WEB=
SENTRY_DSN_MOBILE=

# ── Worker Auth ─────────────────────────────────────────────
WORKER_API_KEY=

# ── Reminder Worker ─────────────────────────────────────────
PREFETCH_COUNT=10
REMINDER_EXTRACTION_ENABLED=true
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=300

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@docvault.app
SMTP_TLS=true

# ── Notification Schedule ────────────────────────────────────
NOTIFY_DAYS_BEFORE=30,7,1
NOTIFY_ON_DATE=true
NOTIFY_AT_TIME=09:00
